# =============================================================================
# CRM OPA · ambiente de PRODUÇÃO
#
# Não preencha à mão os campos marcados [GERADO]:
#   node scripts/producao/gerar-segredos.mjs
# cria o .env.producao a partir deste arquivo, gera todos os segredos e nunca
# os imprime. Rodar de novo só completa o que falta (não troca chave existente).
#
# Os campos [VOCÊ] vêm das contas da OPA/G-Compass (Supabase, domínio, IA).
# Os [FIXO] já estão no valor certo para a OPA.
#
# Depois de pronto: node scripts/producao/conferir-producao.mjs
# Roteiro completo: docs/PRODUCAO-OPA.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Domínio e imagem
# -----------------------------------------------------------------------------
# [VOCÊ] Endereço do CRM. Registro A no DNS apontando para o IP da VPS.
DOMAIN=crm.opailhabela.com.br
# [VOCÊ] E-mail que recebe aviso do certificado HTTPS (Let's Encrypt).
ACME_EMAIL=
# [FIXO] Imagem do NOSSO fork (publicada pelo GitHub Actions do gcompassofc).
IMAGE_REPO=ghcr.io/gcompassofc/gcompass-crm
APP_IMAGE=ghcr.io/gcompassofc/gcompass-crm:latest
APP_PULL_POLICY=always

# -----------------------------------------------------------------------------
# 2) Supabase (projeto novo, região São Paulo: sa-east-1)
#    Settings > API e Settings > Database > Connection string (URI, porta 5432)
# -----------------------------------------------------------------------------
# [VOCÊ]
NEXT_PUBLIC_SUPABASE_URL=
# [VOCÊ] chave "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [VOCÊ] chave "service_role" / "secret". Nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=
# [VOCÊ] postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# 3) Endereços do app (precisam bater com DOMAIN)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://crm.opailhabela.com.br
NEXT_PUBLIC_ADMIN_URL=https://crm.opailhabela.com.br/admin

# -----------------------------------------------------------------------------
# 4) IA do copiloto (lê as conversas). Vazio = copiloto por regras, sem IA.
# -----------------------------------------------------------------------------
# [VOCÊ] console.anthropic.com > API Keys (chave própria da OPA, com limite de gasto)
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 5) Segredos do sistema [GERADO]
# -----------------------------------------------------------------------------
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
INVITE_TOKEN_SECRET=
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
WAHA_BYO_ENCRYPTION_KEY=
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# -----------------------------------------------------------------------------
# 6) Cifra dos dados pessoais [GERADO]
#    Guarde uma cópia destas três no cofre de senhas da G-Compass: sem elas,
#    nome, telefone e conversa cifrados não abrem mais. Nunca no repositório.
# -----------------------------------------------------------------------------
PII_CHAVES=
PII_CHAVE_ATUAL=
PII_CHAVE_INDICE=

# -----------------------------------------------------------------------------
# 7) WhatsApp (WAHA, só na rede interna do servidor)
# -----------------------------------------------------------------------------
# [FIXO] O app fala com o WAHA e o WAHA devolve o webhook pela rede interna:
# nada disso passa pela internet.
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
# [GERADO]
WAHA_API_KEY=
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
# [FIXO] O WAHA Core não assina o webhook. Com WAHA Plus, troque para true.
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false

# -----------------------------------------------------------------------------
# 8) Redis (no próprio servidor)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=http://srh:80
# [GERADO] (os dois são o mesmo valor)
SRH_TOKEN=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 9) Segurança e privacidade [FIXO]
# -----------------------------------------------------------------------------
NODE_ENV=production
# Vazio = nenhum relatório de erro sai do servidor (LGPD). Sentry próprio: cole o DSN.
SENTRY_DSN=
# Cadastro só por convite.
CADASTRO_ABERTO=false
# Origem extra de foto de imóvel na CSP, separada por espaço (ex.: CDN nova).
CSP_IMG_EXTRA=
# [VOCÊ] E-mail de quem responde pelos dados (LGPD). Aparece nos pedidos de titular.
LGPD_DPO_EMAIL=
LGPD_EXPORT_EXPIRES_HOURS=72

# -----------------------------------------------------------------------------
# 10) E-mail dos convites (opcional). Sem Resend, a tela mostra o link para copiar.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# 11) Marca e perfil da OPA [FIXO]
# -----------------------------------------------------------------------------
APP_NAME=CRM OPA
APP_LOGO_URL=/opa/opa-logo.svg
APP_THEME_DEFAULT=light
APP_PALETTE=opa
APP_PROFILE=imobiliaria
NUVEMSHOP_ENABLED=false
EVENT_LOG_WORKER_ENABLED=false
INTERNAL_AGENT_RUN_STUB=false
AGENT_DISPATCH_CONSUMER=engine
META_GRAPH_VERSION=v22.0

# -----------------------------------------------------------------------------
# 12) Primeiro administrador (o instalador da VPS cria e exige o segundo fator)
# -----------------------------------------------------------------------------
# [VOCÊ]
OWNER_EMAIL=
# [VOCÊ] 12 caracteres ou mais. O instalador lê daqui; apague depois de instalar.
OWNER_PASSWORD=
